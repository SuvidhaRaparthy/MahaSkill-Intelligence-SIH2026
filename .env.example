# MahaSkill Intelligence - Environment Variables Configuration

# Supabase PostgreSQL & Auth Credentials
VITE_SUPABASE_URL=https://your-supabase-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Optional: Server-Side Supabase Service Role Key (NEVER EXPOSE IN FRONTEND)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Secure Server-Side Gemini API Key (Used in Edge Functions for AI Skill Extraction & Assistant)
GEMINI_API_KEY=your-gemini-api-key
